{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "dev",
			"label": "Vite: Dev",
			"detail": "Vite Development Server for Browser Extensions",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"icon": {
				"color": "terminal.ansiCyan"
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"owner": "wxt",
					// This is a placeholder pattern and won't actually match anything.
					"pattern": {
						"regexp": "xxx(x)(x)(x)",
						"file": 1,
						"line": 2,
						"code": 3,
						"message": 4
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^vite",
						"endsPattern": "VITE v\\d+\\.\\d+\\.\\d+\\s+ready in"
					}
				}
			]
		},
		{
			"type": "npm",
			"script": "build",
			"label": "Vite: Build",
			"detail": "Run vite build to produce production assets",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"icon": {
				"color": "terminal.ansiYellow"
			},
			"isBackground": false
			// No problemMatcher for build; adjust if you add a matcher later.
		}
	]
}