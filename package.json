{
  "name": "vite-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "types": "pnpm wrangler types",
    "postinstall": "pnpm installChrome",
    "installChrome": "pwsh -c \"$chrome=(pnpm dlx @puppeteer/browsers install chrome --path .browsers).split(' ')[1];New-Item -ItemType SymbolicLink -Path '.browsers/chrome-testing' -Target (Join-Path $PWD (Split-Path $chrome)) -Force\"",
    "buildPimClient": "pnpm dlx @kiota-community/kiota-gen generate --openapi https://aka.ms/graph/v1.0/openapi.yaml --include-path /roleManagement/directory/** --include-path /identityGovernance/privilegedAccess/group/** -l TypeScript -o src/api/generated/msgraph -c PimGraphClient"
  },
  "dependencies": {
    "@azure/arm-authorization": "^9.0.0",
    "@azure/arm-managementgroups": "^2.0.2",
    "@azure/arm-resources-subscriptions": "^2.1.0",
    "@azure/arm-subscriptions": "^5.1.0",
    "@azure/identity": "^4.12.0",
    "@azure/msal-browser": "^4.24.1",
    "@azure/msal-react": "^3.0.20",
    "@formkit/auto-animate": "^0.9.0",
    "@mantine/core": "^8.3.2",
    "@mantine/dates": "^8.3.2",
    "@mantine/form": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.2",
    "@microsoft/kiota-abstractions": "1.0.0-preview.98",
    "@microsoft/kiota-authentication-azure": "1.0.0-preview.98",
    "@microsoft/kiota-bundle": "1.0.0-preview.98",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.98",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.98",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.98",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.98",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.98",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@threeveloper/azure-react-icons": "^1.1.1",
    "ag-grid-community": "^34.2.0",
    "ag-grid-react": "^34.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "humanize-duration": "^3.33.1",
    "mantine-datatable": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-pattern": "^5.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@eslint/js": "^9.36.0",
    "@tanstack/eslint-plugin-query": "^5.91.0",
    "@types/chrome": "^0.1.17",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "@vite-pwa/assets-generator": "^1.0.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.42.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@microsoft/kiota-abstractions": "patches/@microsoft__kiota-abstractions.patch"
    }
  },
  "resolutions": {
    "sharp": "0.32.6",
    "sharp-ico": "0.1.5"
  }
}