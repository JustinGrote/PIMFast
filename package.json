{
  "name": "PIM Fast",
  "description": "A faster, unified interface to Entra ID Privileged Identity Management for Roles, Groups, and Resources",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare && pnpm installChrome",
    "installChrome": "pwsh -c \"$chrome=(pnpm dlx @puppeteer/browsers install chrome --path .wxt).split(' ')[1];New-Item -ItemType SymbolicLink -Path '.wxt/chrome-testing' -Target (Join-Path $PWD (Split-Path $chrome)) -Force\"",
    "buildPimClient": "pnpm dlx @kiota-community/kiota-gen generate --openapi https://aka.ms/graph/v1.0/openapi.yaml --include-path /roleManagement/directory/** --include-path /identityGovernance/privilegedAccess/group/** -l TypeScript -o src/api/generated/msgraph -c PimGraphClient"
  },
  "dependencies": {
    "@azure/arm-authorization": "^9.0.0",
    "@azure/arm-managementgroups": "^2.0.2",
    "@azure/arm-resources-subscriptions": "^2.1.0",
    "@azure/arm-subscriptions": "^5.1.0",
    "@azure/identity": "^4.12.0",
    "@azure/msal-browser": "3.30.0",
    "@formkit/auto-animate": "^0.8.4",
    "@mantine/core": "^8.3.2",
    "@mantine/dates": "^8.3.2",
    "@mantine/form": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.2",
    "@microsoft/kiota-abstractions": "1.0.0-preview.97",
    "@microsoft/kiota-authentication-azure": "1.0.0-preview.97",
    "@microsoft/kiota-bundle": "1.0.0-preview.97",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.97",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.97",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.97",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.97",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.97",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@threeveloper/azure-react-icons": "^1.1.1",
    "ag-grid-community": "^34.2.0",
    "ag-grid-react": "^34.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "humanize-duration": "^3.33.1",
    "mantine-datatable": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-pattern": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@kiota-community/kiota-gen": "^1.0.2",
    "@microsoft/kiota": "^1.28.0",
    "@tanstack/eslint-plugin-query": "^5.90.1",
    "@types/chrome": "^0.1.12",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.0",
    "prettier": "^3.6.2",
    "react-devtools": "^6.1.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "wxt": "^0.20.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "@azure/msal-browser@3.30.0": "patches/@azure__msal-browser@3.30.0.patch",
      "@microsoft/kiota-abstractions": "patches/@microsoft__kiota-abstractions.patch"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}